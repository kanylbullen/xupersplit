# Copy to .env.local and fill in your own Supabase project values.
# Both are safe to expose in the client bundle (publishable/anon credentials);
# security relies on RLS + RPCs, not on hiding these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Optional. Without it, feedback is still stored — you just won't be emailed
# about it. Resend API key; the sender must be a verified domain there.
# RESEND_API_KEY=re_...
# FEEDBACK_EMAIL_TO=split@xuper.fun

# Vercel only, production only. `track()` from @vercel/analytics/server posts to
# $VERCEL_URL — the per-deployment URL — which is covered by this project's
# deployment protection, so every server-side event was answered 401 and dropped
# without a trace. Pointing it at the production domain is what makes the
# mcp_connect / mcp_tool / new-split events actually land. Set in the Vercel
# project (Production scope), not here; preview deployments have no unprotected
# domain to post to and stay dark on purpose.
# VERCEL_WEB_ANALYTICS_ENDPOINT=https://split.xuper.fun/_vercel/insights/event
